# Gateway API CRDs, standard channel. Cluster-scoped and installed before everything that uses them (wave -3).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gateway-api
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  project: [[ project ]]
  source:
    repoURL: https://github.com/kubernetes-sigs/gateway-api.git
    # v1.6.3, by the tag's commit. The version Traefik v3.7.17 is built against (its go.mod); cert-manager v1.21
    # builds against v1.6.0; veyq needs v1.5 or later (ListenerSet in the standard channel). v1.7.0 (2026-10-29)
    # is newer than both consumers — move with Traefik.
    # renovate: datasource=github-tags depName=kubernetes-sigs/gateway-api version=v1.7.0
    targetRevision: e26d183dbbc1bb782b78addbd26faba03955c152
    path: config/crd
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    # No prune, ever: deleting a CRD deletes every object of its kind in the cluster.
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - ServerSideApply=true
