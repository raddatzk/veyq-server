# The root of the app of apps. Applied once by Ansible (role argocd); from then on it syncs gitops/apps, whose
# kustomization lists one Application per app. Adding an app = a directory under gitops/apps + one line there.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: [[ project ]]
  source:
    repoURL: [[ repo_url ]]
    targetRevision: [[ branch ]]
    path: gitops/apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    # Prune here removes an Application whose directory was deleted. No child Application carries the
    # resources-finalizer, so that never cascades into the app's own resources (volumes included).
    automated:
      prune: true
      selfHeal: true
